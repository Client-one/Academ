# Copy this file to .env.local and fill in the real values.
# NEVER commit real values. NEVER put the service role key in NEXT_PUBLIC_*.

# Public — safe to expose to the browser (restricted by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — Auth Admin API only (student provisioning, password resets,
# private university-number lookup). Never used for ordinary CRUD.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
